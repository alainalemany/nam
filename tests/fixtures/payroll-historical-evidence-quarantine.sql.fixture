-- Synthetic changes made after migrations 34 and 35 but before migration 36.
-- They deliberately demonstrate that current names and current paycheck values
-- cannot prove historical identity or rate provenance.

UPDATE "Employee"
SET "displayName" = 'Renamed Unique Operator', "updatedAt" = TIMESTAMP '2026-06-29 12:00:00'
WHERE "id" = 'migration-employee-unique';

INSERT INTO "Employee" (
  "id", "employeeCode", "displayName", "isActive", "isSupervisor", "updatedAt"
) VALUES
  ('migration-employee-later-duplicate', 'MIG-LATER-DUP', 'Unique Operator', true, false, TIMESTAMP '2026-06-29 12:00:00');

