-- The paycheck is later corrected and its period is moved, while the old rate
-- remains linked. Migration 36 must preserve the link only as candidate data.
UPDATE "Paycheck"
SET "baseRate" = NULL, "correctedAt" = TIMESTAMP '2026-06-30 12:00:00', "updatedAt" = TIMESTAMP '2026-06-30 12:00:00'
WHERE "id" = 'migration-paycheck-unique-rate';

UPDATE "PayrollPeriod"
SET "periodStart" = DATE '2026-06-02', "updatedAt" = TIMESTAMP '2026-06-30 12:00:00'
WHERE "id" = 'migration-period-unique-rate';

UPDATE "EmployeePayRate"
SET "createdAt" = TIMESTAMP '2026-06-01 10:00:00', "updatedAt" = TIMESTAMP '2026-06-01 10:00:00'
WHERE "id" LIKE 'migration-rate-%';
