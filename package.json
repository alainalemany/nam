{
  "name": "nam-dashboard",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "lint": "tsc --noEmit",
    "geography:import": "node --experimental-strip-types scripts/geography/import-us-geography.ts",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "prisma:generate": "prisma generate",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ddr": "playwright test tests/e2e/dragline-delay-report-stability.spec.ts",
    "test:run": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.556.0",
    "mdast-util-from-markdown": "2.0.3",
    "next": "15.5.22",
    "pdf-parse": "2.4.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "3.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.1.17",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/mdast": "4.0.4",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "prisma": "^6.16.3",
    "tailwindcss": "4.1.17",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "next@15.5.22>postcss": "8.5.18",
      "next@15.5.22>sharp": "-"
    }
  }
}
