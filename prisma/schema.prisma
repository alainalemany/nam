  title                             String
  normalizedTitle                   String
  bodyMarkdown                      String
  safetyCaution                     String?
  contextKind                       KnowledgeContextKind                 @default(GENERAL)
  mineId                            String?
  mine                              Mine?                                @relation("KnowledgeRevisionMine", fields: [mineId], references: [id], onDelete: SetNull, map: "KnowledgeRecordRevision_mine_fkey")
  equipmentId                       String?
  equipment                         Equipment?                           @relation("KnowledgeRevisionEquipment", fields: [equipmentId], references: [id], onDelete: SetNull, map: "KnowledgeRecordRevision_equipment_fkey")
  equipmentDisplayNameSnapshot      String?
  equipmentNumberSnapshot           String?
  equipmentCategorySnapshot         EquipmentCategory?
  mineNameSnapshot                  String?
  cityNameSnapshot                  String?
  cityStateSnapshot                 String?
  sourceDailyLogId                  String?
  sourceDailyLog                    DailyLog?                            @relation("KnowledgeRevisionSourceDailyLog", fields: [sourceDailyLogId], references: [id], onDelete: SetNull, map: "KnowledgeRecordRevision_sourceDailyLog_fkey")
  sourceDailyLogDateSnapshot        DateTime?                            @db.Date
  sourceDailyLogShiftSnapshot       ShiftType?
  relatedDefectId                   String?
  relatedDefect                     Defect?                              @relation("KnowledgeRevisionRelatedDefect", fields: [relatedDefectId], references: [id], onDelete: SetNull, map: "KnowledgeRecordRevision_relatedDefect_fkey")
  relatedDefectTitleSnapshot        String?
  relatedDefectReportedDateSnapshot DateTime?                            @db.Date
  changeSummary                     String?
  reviewedAt                        DateTime?
