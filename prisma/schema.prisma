model KnowledgeRecord {
  id                          String                    @id @default(uuid()) @db.Uuid
  currentRevisionId           String?                   @db.Uuid
  currentRevision             KnowledgeRecordRevision?  @relation("KnowledgeRecordCurrentRevision", fields: [currentRevisionId, id], references: [id, knowledgeRecordId], onDelete: Restrict, map: "KnowledgeRecord_currentRevision_owner_fkey")
  revisions                   KnowledgeRecordRevision[] @relation("KnowledgeRecordOwnedRevisions")
  lifecycle                   KnowledgeRecordLifecycle  @default(ACTIVE)
  stateVersion                Int                       @default(1)
  createSubmissionKey         String                    @unique(map: "KnowledgeRecord_submissionKey_key") @db.Uuid
  createSubmissionFingerprint String                    @db.Char(64)
  archivedAt                  DateTime?
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt

  @@unique([currentRevisionId, id], map: "KnowledgeRecord_current_owner_key")
  @@index([lifecycle, updatedAt, id], map: "KnowledgeRecord_lifecycle_updated_idx")
}

model KnowledgeRecordRevision {
