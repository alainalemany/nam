  role              AssignmentCrewRole
  employeeId        String?
  employee          Employee?           @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  displayName       String?
  isUnknown         Boolean             @default(false)
  notes             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([dailyAssignmentId, phase, role])
  @@index([phase])
  @@index([role])
  @@index([employeeId])
}

model WeeklyTimesheet {
  id                         String           @id @default(cuid())
  payrollWeekStartDate       DateTime         @db.Date
  payrollWeekEndDate         DateTime         @db.Date
