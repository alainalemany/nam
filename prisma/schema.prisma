  knowledgeRecordId                 String                               @db.Uuid
  knowledgeRecord                   KnowledgeRecord                      @relation("KnowledgeRecordOwnedRevisions", fields: [knowledgeRecordId], references: [id], onDelete: Cascade, map: "KnowledgeRecordRevision_record_fkey")
